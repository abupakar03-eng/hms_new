# Copy to `.env` in the repository root. Every value is optional for a local
# install; the comments say when to set it.

# development | staging | production. "production" refuses to start with
# unsafe settings (missing SECRET_KEY, SQLite, TRUSTED_HOSTS=*, ...).
ENVIRONMENT=development

# JWT signing key, 32+ random characters. Unset: a key is generated once and
# stored in .secret_key (fine on a single machine; set it for anything shared).
# SECRET_KEY=

# Empty = local SQLite file (hms_local.db). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://hms:change-me@127.0.0.1:5432/hms

# Password for the first administrator on a brand-new database. They must
# change it at first sign-in either way.
# ADMIN_PASSWORD=

# Serve the built React app from the API process (single service on :8000).
SERVE_FRONTEND=true

# Comma-separated browser origins allowed to call the API (dev server only).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hostnames this server answers to; restrict in production, e.g. hms.local
TRUSTED_HOSTS=*

# text for a console, json for a log collector.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Sessions
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=1
